bleopt term_modifyOtherKeys_internal=0

# purple syntax colors
ble-face -s command_builtin       fg=#c792ea,bold
ble-face -s command_alias         fg=#c792ea,bold
ble-face -s command_function      fg=#c792ea,bold
ble-face -s command_file          fg=#c792ea,bold
ble-face -s command_keyword       fg=#ff7ac6,bold
ble-face -s command_jobs          fg=#ff7ac6
ble-face -s command_directory     fg=#a3c2f0,underline
ble-face -s syntax_default        fg=#e2d6ff
ble-face -s argument_option       fg=#ff9ae0
ble-face -s argument_error        fg=#ff5c7a
ble-face -s syntax_quoted         fg=#9ae6c2
ble-face -s syntax_quotation      fg=#78d6aa,bold
ble-face -s syntax_param_expansion fg=#f6c98e
ble-face -s varname_unset         fg=#f6c98e
ble-face -s varname_export        fg=#f6c98e,bold
ble-face -s syntax_delimiter      fg=#ff7ac6,bold
ble-face -s syntax_comment        fg=#6b7d9c,italic
ble-face -s syntax_error          bg=#5c1a33,fg=#ffffff
ble-face -s filename_directory    fg=#a3c2f0,underline
ble-face -s filename_executable   fg=#c792ea,underline
ble-face -s filename_other        fg=#e2d6ff,underline
ble-face -s auto_complete         fg=#6a5a99
