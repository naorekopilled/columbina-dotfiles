{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  // same as config.jsonc, info cut to 36 cols / 21 lines so the logo fits an 80x24 window
  "logo": {
    "type": "iterm",
    "source": "~/.config/fastfetch/kuuhenki.png",
    "width": 40,
    "height": 20,
    "padding": { "top": 1, "left": 1, "right": 3 }
  },
  "display": {
    "color": {
      "keys": "38;2;172;171;242",
      "title": "38;2;201;80;143",
      "output": "38;2;220;229;242",
      "separator": "38;2;44;76;112"
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    { "type": "packages", "format": "{all}" },
    "shell",
    { "type": "de", "key": "DE" },
    { "type": "wm", "key": "WM" },
    { "type": "terminal", "format": "{pretty-name}" },
    { "type": "cpu", "format": "{name}" },
    { "type": "gpu", "format": "{name}", "hideType": "integrated" },
    "memory",
    "swap",
    { "type": "disk", "key": "Disk", "folders": "/", "format": "{size-used} / {size-total} ({size-percentage})" },
    { "type": "localip", "key": "Local IP" },
    "locale",
    "break",
    "colors"
  ]
}
